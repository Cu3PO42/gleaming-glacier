---
defines:
    active1: accent1
    active2: accent1
    inactive1: accent2
    inactive2: accent2
---
hl.layer_rule({
    match = { namespace = "match:namespace waybar" },
    -- TODO: manual review — unmapped layer rule: "blur on"
})

hl.config({
    general = {
        gaps_in = 3,
        gaps_out = 8,
        border_size = 2,
        col = {
            active_border = { colors = { "rgba(⟨active1:hex⟩ff)", "rgba(⟨active2:hex⟩ff)" }, angle = 45 },
            inactive_border = { colors = { "rgba(⟨inactive1:hex⟩cc)", "rgba(⟨inactive2:hex⟩cc)" }, angle = 45 },
        },
        layout = "dwindle",
        resize_on_border = true,
    },
    group = {
        col = {
            border_active = { colors = { "rgba(⟨active1:hex⟩ff)", "rgba(⟨active2:hex⟩ff)" }, angle = 45 },
            border_inactive = { colors = { "rgba(⟨inactive1:hex⟩cc)", "rgba(⟨inactive2:hex⟩cc)" }, angle = 45 },
            border_locked_active = { colors = { "rgba(⟨active1:hex⟩ff)", "rgba(⟨active2:hex⟩ff)" }, angle = 45 },
            border_locked_inactive = { colors = { "rgba(⟨inactive1:hex⟩cc)", "rgba(⟨inactive2:hex⟩cc)" }, angle = 45 },
        },
    },
    decoration = {
        rounding = 10,
        shadow = {
            enabled = false,
        },
        blur = {
            enabled = true,
            size = 6,
            passes = 3,
            new_optimizations = true,
            ignore_opacity = true,
            xray = false,
        },
    },
})
